# syntax=docker/dockerfile:1.7
# The management platform: static files served by an unprivileged nginx that also proxies
# /management/ to the API (same origin, no CORS). No secrets in the image.
#   docker build -f deploy/docker/Dockerfile.platform -t aicopilot-platform .

FROM node:22.15.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NX_DAEMON=false CI=true
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec nx run platform:build --skip-nx-cache

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --chown=nginx:nginx deploy/docker/platform.nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build --chown=nginx:nginx /repo/apps/platform/web-dist /usr/share/nginx/html
ENV API_UPSTREAM=http://api:4000
# nginx-unprivileged runs as a non-root user and listens on 8080.
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
