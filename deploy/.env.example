# Copy to deploy/.env for `docker compose --env-file deploy/.env up`. PLACEHOLDERS ONLY:
# generate your own values; never commit deploy/.env.
#   openssl rand -hex 32        -> POSTGRES_PASSWORD, AICOPILOT_JWT_SECRET, AICOPILOT_METRICS_TOKEN
#   openssl rand -base64 32     -> AICOPILOT_SECRET_KEY (encrypts platform-stored secrets)
AICOPILOT_ENV=production
POSTGRES_PASSWORD=
AICOPILOT_JWT_SECRET=
AICOPILOT_JWT_ISSUER=aicopilot
AICOPILOT_JWT_AUDIENCE=aicopilot-api
AICOPILOT_SECRET_KEY=
AICOPILOT_METRICS_TOKEN=
AICOPILOT_MODEL_PROVIDER=openai
AICOPILOT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LOG_LEVEL=info
AICOPILOT_RETENTION_CONVERSATION_DAYS=
AICOPILOT_RETENTION_AUDIT_DAYS=
