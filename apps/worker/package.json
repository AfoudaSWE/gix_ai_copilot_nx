{
  "name": "@gixcopilot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: knowledge ingestion, retention/expiry maintenance and application jobs (workflows, evals) on BullMQ, with graceful shutdown.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@gixcopilot/config": "workspace:*",
    "@gixcopilot/jobs": "workspace:*",
    "@gixcopilot/knowledge": "workspace:*",
    "@gixcopilot/management": "workspace:*",
    "@gixcopilot/persistence-postgres": "workspace:*",
    "@gixcopilot/rag": "workspace:*",
    "@gixcopilot/vectorstore-pgvector": "workspace:*",
    "@gixcopilot/usage": "workspace:*",
    "@gixcopilot/security": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "testcontainers": "^12.1.0",
    "vitest": "5.0.1"
  }
}
