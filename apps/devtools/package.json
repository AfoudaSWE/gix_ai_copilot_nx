{
  "name": "@gixcopilot/devtools-app",
  "version": "0.1.0",
  "private": true,
  "description": "The AI Copilot DevTools UI - a React app that inspects a running copilot through the DevTools API, or an imported debug bundle, without ever importing server or runtime internals.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@gixcopilot/devtools": "workspace:*",
    "@gixcopilot/evals": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/telemetry": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
