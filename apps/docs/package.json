{
  "name": "@gixcopilot/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation portal: renders the repository Markdown (guides, production, reference, migrations); build fails on broken links; quickstart snippets are type-checked.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.snippets.json",
    "test": "tsc -p tsconfig.snippets.json && vitest run",
    "lint": "eslint src",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@angular/core": "21.2.24",
    "@angular/common": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@gixcopilot/angular": "workspace:*",
    "@gixcopilot/node": "workspace:*",
    "@gixcopilot/provider-openai": "workspace:*",
    "@gixcopilot/react": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "@gixcopilot/ui": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
