{
  "name": "@gixcopilot/docs",
  "version": "0.1.0",
  "private": true,
  "description": "GIX AI website and documentation portal: marketing site, docs rendered from the repository Markdown, generated API reference, build-time search index, prerendered static HTML; the build fails on broken links and quickstart snippets are type-checked.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.snippets.json",
    "test": "tsc -p tsconfig.snippets.json && vitest run",
    "lint": "eslint src",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@angular/common": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@gixcopilot/angular": "workspace:*",
    "@gixcopilot/connectors": "workspace:*",
    "@gixcopilot/mcp": "workspace:*",
    "@gixcopilot/node": "workspace:*",
    "@gixcopilot/provider-openai": "workspace:*",
    "@gixcopilot/react": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "@gixcopilot/ui": "workspace:*",
    "@gixcopilot/vue": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "zod": "4.6.5"
  }
}
