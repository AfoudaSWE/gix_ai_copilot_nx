{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [
    "scope:api-app",
    "type:app"
  ],
  "implicitDependencies": [
    "config",
    "core",
    "devtools",
    "evals",
    "jobs",
    "management",
    "model-router",
    "persistence-postgres",
    "provider",
    "provider-mock",
    "provider-openai",
    "redis",
    "security",
    "server",
    "telemetry",
    "tenancy",
    "tools",
    "usage"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/api"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "apps/api"
      }
    }
  }
}
