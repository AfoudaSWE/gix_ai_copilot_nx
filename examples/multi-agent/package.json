{
  "name": "@gixcopilot/multi-agent-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 10 demonstration: an orchestrator agent (@gixcopilot/agents) delegating to Application/Payment/Knowledge specialist agents with deliberately different tool/knowledge access, proving delegation never expands the caller's own privileges.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "demo": "tsc -b tsconfig.json && node dist/main.js"
  },
  "dependencies": {
    "@gixcopilot/agents": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/provider-mock": "workspace:*",
    "@gixcopilot/provider-openai": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
