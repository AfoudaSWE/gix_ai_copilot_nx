{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "protocol-demo",
  "projectType": "application",
  "sourceRoot": "examples/protocol-demo/src",
  "tags": ["scope:example", "type:app"],
  "implicitDependencies": ["protocol", "core", "client", "server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "examples/protocol-demo" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "examples/protocol-demo" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "examples/protocol-demo" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "examples/protocol-demo" }
    }
  }
}
