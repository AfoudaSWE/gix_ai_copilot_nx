# Copy to .env and fill in before running `pnpm server` - this example's server always
# talks to real OpenAI (there is no mock fallback at runtime; the mock provider is used
# only by the automated test suite, never by `pnpm server`).
# Set this only in your local .env. Never commit a real API key to this example file.
OPENAI_API_KEY=

# Optional - defaults to gpt-4o-mini when unset.
OPENAI_MODEL=
