{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-studio",
  "projectType": "application",
  "sourceRoot": "examples/studio/src",
  "tags": ["scope:example", "type:app"],
  "implicitDependencies": ["node", "studio"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "pnpm run build", "cwd": "examples/studio" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "pnpm run typecheck", "cwd": "examples/studio" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "pnpm run test", "cwd": "examples/studio" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "pnpm run lint", "cwd": "examples/studio" } }
  }
}
