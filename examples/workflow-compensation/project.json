{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workflow-compensation-demo",
  "projectType": "application",
  "sourceRoot": "examples/workflow-compensation/src",
  "tags": ["scope:example", "type:app"],
  "implicitDependencies": ["protocol", "workflows", "tools", "security"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "examples/workflow-compensation" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "examples/workflow-compensation" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "examples/workflow-compensation" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "examples/workflow-compensation" }
    }
  }
}
