{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-openapi",
  "projectType": "application",
  "sourceRoot": "examples/openapi/src",
  "tags": ["scope:example", "type:app"],
  "implicitDependencies": ["protocol", "core", "client", "server", "tools", "openapi", "security", "provider", "provider-openai"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "examples/openapi" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "examples/openapi" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "examples/openapi" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "examples/openapi" }
    }
  }
}
