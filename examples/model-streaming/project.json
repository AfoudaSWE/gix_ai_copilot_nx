{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "model-streaming-demo",
  "projectType": "application",
  "sourceRoot": "examples/model-streaming/src",
  "tags": ["scope:example", "type:app"],
  "implicitDependencies": [
    "protocol",
    "core",
    "client",
    "server",
    "provider",
    "provider-mock",
    "provider-openai"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "examples/model-streaming" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "examples/model-streaming" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "examples/model-streaming" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "examples/model-streaming" }
    }
  }
}
