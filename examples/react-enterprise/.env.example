# Copy to .env to enable real OpenAI chat. Without it, the server still runs and every
# security/HITL capability (direct actions, approvals, denial, PII redaction, audit) works
# fully - only the natural-language chat panel is unavailable (the server fails fast with a
# clear message rather than substituting a fake model - see src/backend.ts).
OPENAI_API_KEY=

# Required if OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini
