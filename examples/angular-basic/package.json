{
  "name": "@gixcopilot/angular-basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && ng build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "dev": "ng serve --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env dist/server/server.js"
  },
  "dependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@gixcopilot/angular": "workspace:*",
    "@gixcopilot/core": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/provider-mock": "workspace:*",
    "@gixcopilot/server": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
