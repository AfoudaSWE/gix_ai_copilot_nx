{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "users-crud",
  "projectType": "application",
  "sourceRoot": "examples/users-crud",
  "tags": ["scope:example", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "examples/users-crud" },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/web-dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "examples/users-crud" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "examples/users-crud" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "examples/users-crud" }
    }
  }
}
