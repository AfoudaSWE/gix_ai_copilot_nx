{
  "name": "@gixcopilot/ui",
  "version": "0.2.3",
  "description": "Composable, accessible Copilot chat components.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "react",
    "ui",
    "chat",
    "components",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/react": "workspace:*",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.0",
    "vitest": "5.0.1",
    "axe-core": "4.13.0",
    "zod": "4.6.5"
  }
}
