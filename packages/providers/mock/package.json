{
  "name": "@aicopilot/provider-mock",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, non-network ModelProvider used for tests, examples, and CI - no real AI dependency.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aicopilot/protocol": "workspace:*",
    "@aicopilot/provider": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
