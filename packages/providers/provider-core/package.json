{
  "name": "@aicopilot/provider",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-independent model contracts, registry, and model runtime for the AI Copilot SDK.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aicopilot/core": "workspace:*",
    "@aicopilot/protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
