{
  "name": "@gixcopilot/vectorstore-pgvector",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL + pgvector VectorStore adapter for @gixcopilot/rag - the only package in the workspace allowed to depend on drizzle-orm/pg for RAG storage.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/rag": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "testcontainers": "^12.1.0",
    "vitest": "5.0.1"
  }
}
