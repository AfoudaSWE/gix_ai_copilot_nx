{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "studio-preview",
  "projectType": "application",
  "sourceRoot": "packages/studio-preview/src",
  "tags": ["scope:studio-preview", "type:app", "platform:browser"],
  "implicitDependencies": ["react", "ui"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "pnpm run build", "cwd": "packages/studio-preview" }, "outputs": ["{projectRoot}/dist", "{projectRoot}/web-dist"] },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "pnpm run typecheck", "cwd": "packages/studio-preview" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "pnpm run test", "cwd": "packages/studio-preview" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "pnpm run lint", "cwd": "packages/studio-preview" } }
  }
}
