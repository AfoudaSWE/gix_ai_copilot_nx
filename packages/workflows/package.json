{
  "name": "@gixcopilot/workflows",
  "version": "0.1.1",
  "description": "Deterministic workflow engine for the AI Copilot SDK - defineWorkflow, function/tool/agent/approval/condition/parallel steps, checkpoints, pause/resume/cancel, retry, and compensation.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "workflows",
    "orchestration",
    "durable",
    "steps"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/workflows"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/workflows#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/core": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/agents": "workspace:*",
    "zod": "4.6.5",
    "@gixcopilot/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/provider-mock": "workspace:*",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "vitest": "5.0.1",
    "@opentelemetry/api": "1.9.0"
  }
}
