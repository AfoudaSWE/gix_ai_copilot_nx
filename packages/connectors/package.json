{
  "name": "@gixcopilot/connectors",
  "version": "0.2.0",
  "description": "Connect any HTTP or GraphQL API (any language or framework, no OpenAPI document needed) and turn its endpoints into schema-validated, firewall-enforced copilot tools; in TypeScript or from a JSON/YAML manifest.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "connectors",
    "http",
    "integration",
    "tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/connectors"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/connectors#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/openapi": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
