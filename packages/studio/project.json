{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "studio",
  "projectType": "library",
  "sourceRoot": "packages/studio/src",
  "tags": [
    "scope:studio",
    "type:lib",
    "platform:server"
  ],
  "implicitDependencies": [
    "protocol",
    "security",
    "tools",
    "openapi",
    "provider",
    "studio-preview"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/studio"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/studio"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/studio"
      },
      "dependsOn": [
        {
          "projects": [
            "studio-preview"
          ],
          "target": "build"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/studio"
      }
    }
  }
}
