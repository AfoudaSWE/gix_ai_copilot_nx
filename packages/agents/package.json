{
  "name": "@gixcopilot/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent agent runtime for the AI Copilot SDK - agent definitions, registry, lifecycle, routing, delegation, handoff, and planner/executor, reusing the existing model/tool/security stack.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/core": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gixcopilot/provider-mock": "workspace:*",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "vitest": "5.0.1"
  }
}
