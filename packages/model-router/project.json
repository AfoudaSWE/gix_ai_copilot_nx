{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "model-router",
  "projectType": "library",
  "sourceRoot": "packages/model-router/src",
  "tags": [
    "scope:model-router",
    "type:lib",
    "platform:server"
  ],
  "implicitDependencies": [
    "protocol",
    "provider"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/model-router"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/model-router"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/model-router"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/model-router"
      }
    }
  }
}
