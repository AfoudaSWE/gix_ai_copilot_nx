{
  "name": "@gixcopilot/model-router",
  "version": "0.1.0",
  "description": "Production model routing: deterministic strategies (fixed, fallback, capability, policy), capability metadata, per-model health and side-effect-safe fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/model-router"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/model-router#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/provider": "workspace:*"
  },
  "devDependencies": {
    "@gixcopilot/node": "workspace:*",
    "@gixcopilot/provider-mock": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
