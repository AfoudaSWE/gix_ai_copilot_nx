{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk",
  "projectType": "library",
  "sourceRoot": "packages/sdk/src",
  "tags": ["scope:sdk", "type:lib", "platform:server"],
  "implicitDependencies": ["node", "studio", "provider", "provider-mock", "provider-openai", "security", "tools"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "pnpm run build", "cwd": "packages/sdk" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "pnpm run typecheck", "cwd": "packages/sdk" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "pnpm run test", "cwd": "packages/sdk" }, "dependsOn": [{ "projects": ["studio-preview"], "target": "build" }] },
    "lint": { "executor": "nx:run-commands", "options": { "command": "pnpm run lint", "cwd": "packages/sdk" } }
  }
}
