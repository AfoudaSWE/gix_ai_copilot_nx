{
  "name": "@gixcopilot/sdk",
  "version": "0.2.3",
  "description": "One package to add GIX Copilot to an existing project: `npm add @gixcopilot/sdk`, then `npx gix init` detects your repo, installs what each app needs, and prepares reviewable proposals in the Developer Studio.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "installer",
    "react",
    "angular",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gix": "./bin/gix.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "postinstall": "node ./bin/postinstall.js"
  },
  "dependencies": {
    "@gixcopilot/node": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/provider-mock": "workspace:*",
    "@gixcopilot/provider-openai": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/studio": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "fastify": "5.12.5",
    "tsx": "4.23.13"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
