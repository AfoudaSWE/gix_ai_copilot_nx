{
  "name": "@gixcopilot/cli",
  "version": "0.1.0",
  "description": "The aicopilot command line: init, add tool/agent/mcp, import-openapi, dev, test, eval, doctor and db migrations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aicopilot": "./bin/aicopilot.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/config": "workspace:*",
    "@gixcopilot/evals": "workspace:*",
    "@gixcopilot/openapi": "workspace:*",
    "@gixcopilot/persistence-postgres": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
