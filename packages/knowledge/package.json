{
  "name": "@gixcopilot/knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent knowledge source, document, and loader contracts for the AI Copilot SDK - the ingestion boundary RAG builds on.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/mcp": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "mammoth": "^1.11.0",
    "node-html-parser": "^7.0.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "vitest": "5.0.1"
  }
}
