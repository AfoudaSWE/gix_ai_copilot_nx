{
  "name": "@gixcopilot/checkpoint-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL CheckpointStore adapter for @gixcopilot/workflows - the only other package besides @gixcopilot/vectorstore-pgvector allowed to depend on drizzle-orm/pg.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/checkpoint-postgres"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/checkpoint-postgres#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/workflows": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.16.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "testcontainers": "^12.1.0",
    "vitest": "5.0.1"
  }
}
