{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "persistence-postgres",
  "projectType": "library",
  "sourceRoot": "packages/persistence-postgres/src",
  "tags": [
    "scope:persistence-postgres",
    "type:lib",
    "platform:server"
  ],
  "implicitDependencies": [
    "protocol",
    "security",
    "memory",
    "tenancy",
    "checkpoint-postgres",
    "vectorstore-pgvector",
    "usage",
    "management"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/persistence-postgres"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/persistence-postgres"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/persistence-postgres"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/persistence-postgres"
      }
    }
  }
}
