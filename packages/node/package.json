{
  "name": "@gixcopilot/node",
  "version": "0.2.4",
  "description": "Node.js SDK: createCopilot() composes the server, runtime, model providers, tools and security for Fastify, node:http/Express, or in-process use.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "node",
    "server",
    "fastify"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/client": "workspace:*",
    "@gixcopilot/core": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/server": "workspace:*",
    "@gixcopilot/telemetry": "workspace:*",
    "@gixcopilot/tools": "workspace:*"
  },
  "devDependencies": {
    "@gixcopilot/provider-mock": "workspace:*",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
