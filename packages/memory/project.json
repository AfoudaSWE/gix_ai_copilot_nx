{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "memory",
  "projectType": "library",
  "sourceRoot": "packages/memory/src",
  "tags": ["scope:memory", "type:lib", "platform:server"],
  "implicitDependencies": ["protocol", "security", "rag"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/memory"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/memory"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/memory"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/memory"
      }
    }
  }
}
