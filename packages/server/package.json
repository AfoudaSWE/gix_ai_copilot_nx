{
  "name": "@gixcopilot/server",
  "version": "0.1.0",
  "description": "Fastify HTTP/SSE transport adapter for the AI Copilot SDK: adapts @gixcopilot/core's runtime to an HTTP boundary.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gixcopilot/core": "workspace:*",
    "@gixcopilot/protocol": "workspace:*",
    "@gixcopilot/provider": "workspace:*",
    "@gixcopilot/tools": "workspace:*",
    "@gixcopilot/security": "workspace:*",
    "@gixcopilot/telemetry": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
