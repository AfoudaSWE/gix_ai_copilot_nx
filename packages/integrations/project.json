{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "integrations",
  "projectType": "library",
  "sourceRoot": "packages/integrations/src",
  "tags": ["scope:integrations", "type:lib"],
  "implicitDependencies": ["protocol"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "packages/integrations" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "packages/integrations" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "packages/integrations" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "packages/integrations" }
    }
  }
}
