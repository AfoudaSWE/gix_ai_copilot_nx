{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "testing",
  "projectType": "library",
  "sourceRoot": "packages/testing/src",
  "tags": ["scope:testing", "type:lib", "platform:server"],
  "implicitDependencies": [
    "protocol",
    "telemetry",
    "devtools",
    "agents",
    "workflows",
    "tools",
    "security",
    "rag",
    "knowledge",
    "memory",
    "provider"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/testing"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/testing"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/testing"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/testing"
      }
    }
  }
}
