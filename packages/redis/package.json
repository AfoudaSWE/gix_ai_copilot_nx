{
  "name": "@gixcopilot/redis",
  "version": "0.2.0",
  "description": "Redis coordination for multi-instance deployments: distributed rate limiting, lease locks and health checks.",
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "agent",
    "sdk",
    "typescript",
    "redis",
    "rate-limit",
    "locks",
    "pubsub"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfoudaSWE/gix_ai_copilot_nx.git",
    "directory": "packages/redis"
  },
  "homepage": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/tree/main/packages/redis#readme",
  "bugs": {
    "url": "https://github.com/AfoudaSWE/gix_ai_copilot_nx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-helper.*",
    "!dist/**/*.integration.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.1.0",
    "testcontainers": "^12.1.0",
    "vitest": "5.0.1"
  }
}
